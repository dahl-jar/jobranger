{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "mutate": ["src/**/*.ts?(x)", "!src/**/*.test.ts?(x)", "!src/test/**", "!src/**/{goldenPayloads,testRoutes,testData,*.samples}.ts", "build/**/*.ts", "!build/**/*.test.ts"],
  "reporters": ["html", "progress"]
}
