<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>jobranger</AssemblyName>
    <RootNamespace>Jobranger.Cli</RootNamespace>
    <Version>0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <RuntimeIdentifiers>osx-arm64;linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ace4896.DBus.Services.Secrets" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="Microsoft.ML.Tokenizers" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="System.Numerics.Tensors" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\contracts\src\Jobranger.Contracts\Jobranger.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="$(NuGetPackageRoot)microsoft.ml.onnxruntime\*\runtimes\win-*\native\*.dll" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Catalogue\catalogue.json" LogicalName="catalogue.json" />
    <EmbeddedResource Include="Features\Models\prices.json" LogicalName="Jobranger.Cli.Features.Models.prices.json" />
    <EmbeddedResource Include="Secrets\key-folds-*.json" LogicalName="Jobranger.Cli.Secrets.key-folds.json" />
    <EmbeddedResource Include="Text\entities.json" LogicalName="entities.json" />
    <EmbeddedResource Include="Text\python-text-15.0.0.json" LogicalName="python-text.json" />
    <EmbeddedResource Include="Features\Sessions\wordlist.txt" LogicalName="Jobranger.Cli.Features.Sessions.wordlist.txt" />
    <EmbeddedResource Include="Features\Matching\prompt_header.txt" LogicalName="Jobranger.Cli.Features.Matching.prompt_header.txt" />
    <EmbeddedResource Include="Features\Matching\base_rules.txt" LogicalName="Jobranger.Cli.Features.Matching.base_rules.txt" />
    <EmbeddedResource Include="Features\Matching\assessment_anthropic.json" LogicalName="Jobranger.Cli.Features.Matching.assessment_anthropic.json" />
    <EmbeddedResource Include="Features\Matching\assessment_openai.json" LogicalName="Jobranger.Cli.Features.Matching.assessment_openai.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jobranger.Cli.Tests" />
  </ItemGroup>

</Project>
